PORT=4000
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=60000
DATABASE_URL=

# Alpha AI chat model. LLM_PROVIDER=gemini | openai | rule-based (no key needed).
# Copy this file to backend/.env and put the real key there. Never commit .env.
LLM_PROVIDER=gemini
# Google AI Studio key. Keys created today start with "AQ." (auth keys). Both the AQ.
# and the legacy "AIza" format are accepted on the native Gemini endpoint.
LLM_API_KEY=
# Optional. Leave empty for the built-in default (gemini-3.5-flash) and its fallbacks.
# Flash and Flash-Lite stay on the free plan; Pro models do not.
LLM_MODEL=
# Optional. Override the Gemini endpoint (default https://generativelanguage.googleapis.com/v1beta).
LLM_BASE_URL=
# Optional. Seconds to wait for the model before falling back to the rule-based composer.
LLM_TIMEOUT_MS=45000

MARKET_DATA_PROVIDER=sample
# Exact frontend origin(s), comma separated. Never "*": cookies are sent with credentials.
CORS_ORIGIN=http://localhost:5173

# Authentication (Flask decides; Express relays the session cookie).
# Flask base URL. Trial secure_app on port 5012:  http://127.0.0.1:5012/api   (official: http://127.0.0.1:5001/api)
STOCKTRAIN_API_URL=http://127.0.0.1:5001/api
# How long Express may remember a valid session (ms, capped at 5000).
AUTH_CACHE_TTL_MS=3000
# Must equal AUTH_CSRF_HEADER_VALUE in Flask's .env.auth and VITE_CSRF_HEADER_VALUE (if set) in the frontend.
AUTH_CSRF_HEADER_VALUE=StockTrain
