PORT=4000
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=60000
DATABASE_URL=

# Alpha AI chat model. LLM_PROVIDER=gemini | openai | rule-based (no key needed).
# Copy this file to backend/.env and put the real key there. Never commit .env.
LLM_PROVIDER=gemini
# Google AI Studio key. Keys created today start with "AQ." (auth keys). Both the AQ.
# and the legacy "AIza" format are accepted on the native Gemini endpoint.
LLM_API_KEY=
# Optional. Leave empty for the built-in default (gemini-3.5-flash) and its fallbacks.
# Flash and Flash-Lite stay on the free plan; Pro models do not.
LLM_MODEL=
# Optional. Override the Gemini endpoint (default https://generativelanguage.googleapis.com/v1beta).
LLM_BASE_URL=
# Optional. Seconds to wait for the model before falling back to the rule-based composer.
LLM_TIMEOUT_MS=45000

MARKET_DATA_PROVIDER=sample
CORS_ORIGIN=http://localhost:5173
