PORT=4000
# First test Flask at http://127.0.0.1:5001/api/health
# Trial of the authenticated gateway (secure_app) on port 5012: STOCKTRAIN_API_URL=http://127.0.0.1:5012/api
STOCKTRAIN_API_URL=http://127.0.0.1:5001/api
# Session cache and CSRF header (see .env.example). Every /api/* route except /api/health now needs login.
AUTH_CACHE_TTL_MS=3000
AUTH_CSRF_HEADER_VALUE=StockTrain
STOCKTRAIN_TIMEOUT_MS=10000
# Use 1 by default. Change ONLY after confirming DB stores prices in units of 1000 VND.
STOCKTRAIN_PRICE_MULTIPLIER=1

# Switch to real historical prices for the five E02 tickers (no fake fallback).
MARKET_DATA_PROVIDER=stocktrain
CORS_ORIGIN=http://localhost:5173

# The legacy LSTM microservice is NOT required for the five E02 tickers.
ML_SERVICE_URL=http://localhost:8000
LLM_PROVIDER=rule-based
LLM_API_KEY=
